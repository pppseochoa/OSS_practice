# 실제 값은 배포 서비스의 환경변수 화면에만 설정하고 저장소에 올리지 마세요.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-web-service.example.com
# API가 별도 서비스이면 그 공개 HTTPS 주소를 넣습니다.
SALARY_API_URL=https://your-api-service.example.com
CORS_ALLOWED_ORIGINS=https://your-web-service.example.com
